{
  "name": "monoshell",
  "version": "0.1.0",
  "description": "单窗口 AI 终端：直接敲命令，也直接说人话。危险命令二次确认。",
  "type": "module",
  "bin": {
    "ai": "./dist/index.js",
    "mono": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "start": "node dist/index.js",
    "test": "npm run test:shell && npm run test:agent && npm run test:setup && npm run test:launcher",
    "test:launcher": "tsx test/launcher.ts",
    "test:setup": "tsx test/setup.ts",
    "test:shell": "tsx test/shell.ts",
    "test:agent": "tsx test/agent.ts"
  },
  "dependencies": {
    "openai": "^4.104.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ssh2": "^1.15.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
